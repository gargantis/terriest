{
  "name": "terriest",
  "private": true,
  "version": "0.0.0",
  "description": "Two packs of terriers corral a giant rubber ball into goals: a browser-based, peer-to-peer multiplayer game",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "public-scan": "node scripts/public-scan.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "npm run typecheck && vite build && node scripts/licenses.mjs && node scripts/audit-dist.mjs",
    "e2e": "playwright test",
    "precheck": "node scripts/prebuild.mjs",
    "check": "npm run lint && npm run public-scan && npm run typecheck && npm run test && npm run build && npm run e2e",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "@types/three": "0.187.0",
    "eslint": "^10.0.0",
    "fast-check": "^4.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "0.26.0",
    "three": "0.187.0"
  }
}
