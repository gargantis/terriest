# PLAN D-35: amorfus's headers, with blob: in connect-src, from which
# GLTFLoader fetches a .glb's embedded images. C-58: script-src also takes the
# host of Cloudflare's Web Analytics beacon, which Cloudflare's edge adds to
# each page it serves and the build never holds. The beacon reports to the
# page's own /cdn-cgi/rum, which 'self' in connect-src covers.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Content-Security-Policy: script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' wss: blob:; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
