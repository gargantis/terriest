// Lint fixtures (PLAN D-38): each `// ==` section is one construct, linted
// on its own in a file of each group by scripts/eslint/config.test.mjs.
// Never compiled or bundled. {{src}} is the path from that file to src/.
// Only src/render imports three, from 'three' and 'three/addons/…' only;
// only src/net/trystero.ts imports Trystero, whose types go anywhere;
// src/core imports nothing outside src/core but src/config.ts (M3); and
// src/net/trystero.ts and src/net/dev-relay.ts are loaded only by import(),
// Trystero's file from src/ui/game.ts alone (M3). Everywhere, a specifier
// is a plain string, written without a detour.

// == three
import * as THREE from 'three';
export const v = new THREE.Vector3();

// == three's addons
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
export const l = GLTFLoader;

// == three's types
import type { Vector3 } from 'three';
export type V = Vector3;

// == three re-exported
export { REVISION } from 'three';

// == three imported dynamically
export const m = import('three');

// == three in an import type
export type V = import('three').Vector3;

// == three imported by a template
export const m = import(`three`);

// == a module imported by a variable
export const m = (name: string): Promise<unknown> => import(name);

